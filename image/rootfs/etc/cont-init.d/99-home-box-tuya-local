#!/bin/sh
# Seed baked custom components into /config on first boot (named volumes).
# Lab compose bind-mounts image/custom_components :ro — skip seed then.
set -u

SRC_ROOT=/usr/share/home-box/custom_components

if [ ! -d "${SRC_ROOT}" ]; then
  echo "home-box: no baked custom_components at ${SRC_ROOT}"
  exit 0
fi

mkdir -p /config/custom_components 2>/dev/null || true

# RO bind-mount of custom_components: do not seed.
if ! touch /config/custom_components/.hb_write_test 2>/dev/null; then
  echo "home-box: custom_components is read-only; using bind-mount / image"
  exit 0
fi
rm -f /config/custom_components/.hb_write_test

for name in tuya_local hlk_dio16 home_box_admin; do
  SRC="${SRC_ROOT}/${name}"
  DST="/config/custom_components/${name}"
  if [ ! -d "${SRC}" ]; then
    continue
  fi
  rm -rf "${DST}"
  cp -a "${SRC}" "${DST}"
  echo "home-box: installed ${name} into /config/custom_components"
done
exit 0
